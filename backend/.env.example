# === Application ===
APP_NAME=SmartCS
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartcs
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=86400
REDIS_SEMANTIC_CACHE_TTL=3600

# === LLM Provider (openai | anthropic | local) ===
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30

# === LLM API Keys ===
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# === Embedding ===
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# === Reranker ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# === RAG ===
RAG_DENSE_TOP_K=20
RAG_SPARSE_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_K=5
RAG_CONFIDENCE_HIGH=0.75
RAG_CONFIDENCE_MEDIUM=0.50

# === Agent Safety ===
AUTO_REFUND_MAX_AMOUNT=200
AUTO_REFUND_MAX_DAILY=2
COUPON_DAILY_LIMIT=50
COUPON_SINGLE_MAX=10

# === Sentiment ===
SENTIMENT_THRESHOLD=0.7
SENTIMENT_CRITICAL_THRESHOLD=0.9

# === Audit ===
AUDIT_LOG_RETENTION_DAYS=90

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_MINUTE_AUTH=500

# === JWT ===
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === External APIs ===
LOGISTICS_API_URL=
LOGISTICS_API_KEY=
PAYMENT_API_URL=
PAYMENT_API_KEY=
